# Secrets des Edge Functions — à envoyer avec :
#   supabase secrets set --env-file supabase/.env
# (SUPABASE_URL et SUPABASE_SERVICE_ROLE_KEY sont fournis automatiquement par Supabase)
# Ne jamais committer le vrai fichier .env !

SITE_URL=https://ton-projet.web.app

# Stripe (commence en mode test : sk_test_...)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Brevo
BREVO_API_KEY=xkeysib-xxx
BREVO_LIST_NEWSLETTER=2
BREVO_LIST_CLIENTS=3
BREVO_DOI_TEMPLATE_ID=1
